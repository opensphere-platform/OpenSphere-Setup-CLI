        }
      },
      "spec": {
        "failurePolicy": "Fail",
        "paramKind": {
          "apiVersion": "v1",
          "kind": "ConfigMap"
        },
        "matchConstraints": {
          "resourceRules": [
            {
              "apiGroups": [
                "batch"
              ],
              "apiVersions": [
                "v1"
              ],
              "operations": [
                "CREATE",
                "UPDATE"
              ],
              "resources": [
                "jobs"
              ]
            }
          ]
        },
        "matchConditions": [
          {
            "name": "cm-console-jobs",
            "expression": "request.namespace == 'opensphere-console' && request.userInfo.username == 'system:serviceaccount:opensphere-console:opensphere-cluster-manager-runtime'"
          }
        ],
        "variables": [
          {
            "name": "p",
            "expression": "object.spec.template.spec"
          },
          {
            "name": "c",
            "expression": "variables.p.containers[0]"
          }
        ],
        "validations": [
          {
            "expression": "object.metadata.name.matches('^ceph-prepare-' + '[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}' + '$') && object.spec.backoffLimit == 0 && object.spec.activeDeadlineSeconds == 900 && object.spec.ttlSecondsAfterFinished == 86400",
            "message": "Only bounded Ceph preparation Jobs are permitted"
          },
          {
            "expression": "variables.p.serviceAccountName == 'opensphere-ceph-preparer' && variables.p.restartPolicy == 'Never' && variables.p.containers.size() == 1 && (!has(variables.p.initContainers) || variables.p.initContainers.size() == 0) && (!has(variables.p.ephemeralContainers) || variables.p.ephemeralContainers.size() == 0) && (!has(variables.p.hostNetwork) || !variables.p.hostNetwork) && (!has(variables.p.hostPID) || !variables.p.hostPID) && (!has(variables.p.hostIPC) || !variables.p.hostIPC)",
            "message": "Only the fixed isolated preparer service account may run"
          },
          {
            "expression": "variables.c.image == params.data.image && variables.c.command == ['node','/app/ceph-preparation-worker.js'] && (!has(variables.c.args) || variables.c.args.size() == 0) && (!has(variables.c.envFrom) || variables.c.envFrom.size() == 0) && !has(variables.c.lifecycle)",
            "message": "Only the immutable approved worker and entrypoint are permitted"
          },
          {
            "expression": "variables.c.resources.limits.cpu == '500m' && variables.c.resources.limits.memory == '512Mi' && variables.c.resources.requests.cpu == '50m' && variables.c.resources.requests.memory == '128Mi' && (!has(variables.p.nodeName) || variables.p.nodeName == '') && !has(variables.p.runtimeClassName)",
            "message": "Only the fixed bounded worker resource profile is permitted"
          },
          {
            "expression": "variables.c.env.size() == 1 && variables.c.env[0].name == 'OPERATION_ID' && !has(variables.c.env[0].valueFrom) && variables.c.env[0].value.matches('^' + '[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}' + '$') && object.metadata.name == 'ceph-prepare-' + variables.c.env[0].value",
            "message": "The sole worker input is its bound operation ID"
          },
          {
            "expression": "variables.c.securityContext.allowPrivilegeEscalation == false && variables.c.securityContext.readOnlyRootFilesystem == true && variables.c.securityContext.capabilities.drop == ['ALL'] && (!has(variables.c.securityContext.capabilities.add) || variables.c.securityContext.capabilities.add.size() == 0) && (!has(variables.c.securityContext.privileged) || !variables.c.securityContext.privileged) && variables.p.securityContext.runAsNonRoot && variables.p.securityContext.runAsUser == 1000 && variables.p.securityContext.seccompProfile.type == 'RuntimeDefault'",
            "message": "Preparers cannot elevate or modify their executable filesystem"
          },
          {
            "expression": "variables.p.volumes.size() == 1 && variables.p.volumes[0].name == 'tmp' && has(variables.p.volumes[0].emptyDir) && variables.c.volumeMounts.size() == 1 && variables.c.volumeMounts[0].name == 'tmp' && variables.c.volumeMounts[0].mountPath == '/tmp' && variables.p.imagePullSecrets.size() == 1 && variables.p.imagePullSecrets[0].name == 'opensphere-ghcr-pull'",
            "message": "No arbitrary Secret, host or executable volume mounts are permitted"
          }
        ]
      }
    },
